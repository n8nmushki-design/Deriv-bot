<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header & Account Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deriv Digit Over Bot"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User: user@example.com"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSignOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Out"
                android:textSize="12sp"
                android:backgroundTint="#EF4444"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Status & Main Controls Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvBotStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="STATUS: DISCONNECTED"
                    android:textColor="#EF4444"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnToggleBot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="START BOT"
                    android:backgroundTint="#22C55E"
                    android:textColor="#000000"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Metrics Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2">

                <!-- Metric 1: Balance -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="#0F172A"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_margin="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account Balance"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Metric 2: Session Profit -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="#0F172A"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_margin="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Session P/L"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvSessionProfit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textColor="#22C55E"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Metric 3: Current Barrier -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="#0F172A"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_margin="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Barrier"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvBarrier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Over 0"
                        android:textColor="#F59E0B"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Metric 4: Trading State -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:background="#0F172A"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_margin="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trading State"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTradingState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Idle"
                        android:textColor="#3B82F6"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </GridLayout>
        </LinearLayout>

        <!-- Settings Config Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deriv Strategy Parameters"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deriv API Token"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etDerivToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Deriv API Token"
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#0F172A"
                android:padding="10dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stake ($)"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etStake"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0.25"
                        android:textColor="#FFFFFF"
                        android:inputType="numberDecimal"
                        android:background="#0F172A"
                        android:padding="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily TP ($)"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etDailyTp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="5.0"
                        android:textColor="#FFFFFF"
                        android:inputType="numberDecimal"
                        android:background="#0F172A"
                        android:padding="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily SL ($)"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etDailySl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-1.0"
                        android:textColor="#FFFFFF"
                        android:inputType="numberSigned|numberDecimal"
                        android:background="#0F172A"
                        android:padding="8dp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveDerivSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save Parameters"
                android:textSize="12sp"
                android:backgroundTint="#3B82F6"
                android:layout_gravity="end" />
        </LinearLayout>

        <!-- Live Symbol Probabilities Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Symbol Probabilities (Last 100 Ticks)"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSymbolProbs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waiting for market ticks..."
                android:textColor="#CBD5E1"
                android:fontFamily="monospace"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Activity Logs & Trades History Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Activity Logs &amp; Trades"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvActivityLogs"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="#090D16"
                android:padding="10dp"
                android:textColor="#CBD5E1"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:scrollbars="vertical"
                android:text="[Ready] Initialize bot or configure settings..." />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
